<Project>
  <Target Name="RemoveMissingCefGlueMacOsCopyItems" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;CopyFilesToPublishDirectory" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'libEGL.dylib' Or '%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'libGLESv2.dylib' Or '%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'libvk_swiftshader.dylib'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(_SourceItemsToCopyToOutputDirectoryAlways.Filename)%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == 'libEGL.dylib' Or '%(_SourceItemsToCopyToOutputDirectoryAlways.Filename)%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == 'libGLESv2.dylib' Or '%(_SourceItemsToCopyToOutputDirectoryAlways.Filename)%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == 'libvk_swiftshader.dylib'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libEGL.dylib' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libGLESv2.dylib' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'libvk_swiftshader.dylib'" />
    </ItemGroup>
  </Target>
</Project>
