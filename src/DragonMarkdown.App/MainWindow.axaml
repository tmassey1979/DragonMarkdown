<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DragonMarkdown.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="DragonMarkdown.App.MainWindow"
        MinWidth="980"
        MinHeight="640"
        Width="1360"
        Height="820"
        Title="DragonMarkdown">
    <Window.DataTemplates>
        <TreeDataTemplate DataType="{x:Type vm:WorkspaceNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Glyph}" Width="40" HorizontalAlignment="Center" Foreground="#617184" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="#253041" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type vm:OpenDocumentViewModel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding DisplayName}" Foreground="#253041" />
                <TextBlock Text="*" IsVisible="{Binding IsDirty}" Foreground="#B35C00" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Background="#F3F6FA">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F7F9FC" Foreground="#253041">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Folder..." Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Open _File..." Command="{Binding OpenFileCommand}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveActiveCommand}" />
                <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" />
                <Separator />
                <MenuItem Header="_Validate Export Readiness" Command="{Binding ValidateExportReadinessCommand}" />
                <MenuItem Header="Export to _Word..." Command="{Binding ExportWordCommand}" />
                <MenuItem Header="Export to _PDF..." Command="{Binding ExportPdfCommand}" />
            </MenuItem>
            <MenuItem Header="_Workspace">
                <MenuItem Header="New _File" Command="{Binding CreateFileCommand}" />
                <MenuItem Header="New F_older" Command="{Binding CreateFolderCommand}" />
                <Separator />
                <MenuItem Header="Analyze Docs _Health" Command="{Binding RefreshWorkspaceHealthCommand}" />
                <Separator />
                <MenuItem Header="_Delete Selected" Command="{Binding DeleteSelectedCommand}" />
                <MenuItem Header="_Reveal Selected" Command="{Binding RevealSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Editor" Command="{Binding ToggleEditorCommand}" />
                <MenuItem Header="_Preview" Command="{Binding TogglePreviewCommand}" />
                <Separator />
                <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="DragonMarkdown _Help" Command="{Binding OpenHelpCommand}" />
                <MenuItem Header="Check for _Updates" Command="{Binding CheckForUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_About DragonMarkdown" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#1F2937" Height="42">
            <Grid ColumnDefinitions="Auto,*" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="DragonMarkdown" Foreground="#F9FAFB" FontSize="17" FontWeight="SemiBold" />
                    <Border Background="#324154" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding WorkspaceLabel}" Foreground="#D6DEE9" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#263445" BorderBrush="#1B2430" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Name="MainToolbar" Orientation="Horizontal" Spacing="8">
                <Button Classes="toolbar-button" Content="Open Folder" Command="{Binding OpenFolderCommand}" />
                <Button Classes="toolbar-button" Content="Save" Command="{Binding SaveActiveCommand}" />
                <Button Classes="toolbar-button" Content="Validate Export" Command="{Binding ValidateExportReadinessCommand}" />
                <Button Classes="toolbar-button" Content="Word" Command="{Binding ExportWordCommand}" />
                <Button Classes="toolbar-button" Content="PDF" Command="{Binding ExportPdfCommand}" />
                <Button Classes="toolbar-button" Content="Health" Command="{Binding RefreshWorkspaceHealthCommand}" />
                <Button Classes="toolbar-button" Content="Settings" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Background="#EAF0F7" Height="34">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#506070" FontSize="12" />
                <TextBlock Grid.Column="1" Text="Trusted workspace" VerticalAlignment="Center" Foreground="#506070" FontSize="12" />
            </Grid>
        </Border>

        <Grid Margin="10" ColumnDefinitions="260,6,*,6,*">
            <Border Classes="panel" CornerRadius="7,0,0,7">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <TextBlock Classes="panel-title" Text="WORKSPACE" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="5,2" Content="+" Command="{Binding CreateFileCommand}" />
                            <TextBox Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Watermark="Search files"
                                     Text="{Binding WorkspaceSearchText, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding WorkspaceHealthSummary}"
                                       FontSize="11"
                                       Foreground="#506070"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ListBox ItemsSource="{Binding WorkspaceSearchResults}"
                             SelectedItem="{Binding SelectedWorkspaceSearchResult, Mode=TwoWay}"
                             IsVisible="{Binding IsWorkspaceSearchActive}"
                             MaxHeight="220"
                             Margin="6,6,6,0"
                             Background="#FFFFFF"
                             BorderBrush="#D8E0EA"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenWorkspaceSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#253041" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="#506070" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#617184" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox ItemsSource="{Binding WorkspaceHealthIssues}"
                             SelectedItem="{Binding SelectedWorkspaceHealthIssue, Mode=TwoWay}"
                             IsVisible="{Binding HasWorkspaceHealthIssues}"
                             MaxHeight="230"
                             Margin="6,6,6,0"
                             Background="#FFFFFF"
                             BorderBrush="#D8E0EA"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenWorkspaceHealthIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" />
                                            <TextBlock Text="{Binding Code}" FontSize="10" Foreground="#506070" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#253041" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="#617184" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TreeView ItemsSource="{Binding WorkspaceItems}"
                              SelectedItem="{Binding SelectedWorkspaceItem}"
                              Margin="6"
                              Background="Transparent" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#D8E0EA" ResizeDirection="Columns" />

            <Border Grid.Column="2"
                    Grid.ColumnSpan="{Binding EditorColumnSpan}"
                    Classes="panel"
                    IsVisible="{Binding IsEditorVisible}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,0">
                        <TabControl ItemsSource="{Binding OpenDocuments}"
                                    SelectedItem="{Binding SelectedDocument}"
                                    MinHeight="28" />
                    </Border>
                    <TextBox Name="EditorTextBox"
                             Text="{Binding SelectedDocument.Text, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             FontSize="14"
                             Background="#FFFFFF"
                             Foreground="#1F2937"
                             BorderThickness="0"
                             Padding="14"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3"
                          Background="#D8E0EA"
                          ResizeDirection="Columns"
                          IsVisible="{Binding MiddleSplitterVisible}" />

            <Border Grid.Column="{Binding PreviewGridColumn}"
                    Grid.ColumnSpan="{Binding PreviewColumnSpan}"
                    Classes="panel"
                    CornerRadius="0,7,7,0"
                    IsVisible="{Binding IsPreviewVisible}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panel-title" Text="PREVIEW" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ExportValidationSummary}"
                                       FontSize="11"
                                       Foreground="#506070"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="210,*">
                        <Border Background="#F7F9FC" BorderBrush="#D8E0EA" BorderThickness="0,0,1,0" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Classes="panel-title" Text="OUTLINE" Margin="0,0,0,6" />
                                <ListBox DockPanel.Dock="Bottom"
                                         ItemsSource="{Binding ExportValidationIssues}"
                                         IsVisible="{Binding HasExportValidationIssues}"
                                         MaxHeight="190"
                                         Background="#FFFFFF"
                                         BorderBrush="#D8E0EA"
                                         BorderThickness="1"
                                         Margin="0,8,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Margin="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" />
                                                    <TextBlock Text="{Binding Code}" FontSize="10" Foreground="#506070" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#253041" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{Binding Reference}" FontSize="10" Foreground="#617184" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox ItemsSource="{Binding DocumentOutline}"
                                         SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                                                <TextBlock Text="{Binding Level}" Width="20" FontSize="10" Foreground="#617184" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="#253041" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ContentControl Grid.Column="1" Name="PreviewHost" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    <Border IsVisible="{Binding IsSettingsOpen}"
            Background="#990F172A"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Width="480"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#F7F9FC"
                BorderBrush="#B7C4D3"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <StackPanel Spacing="12">
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="#253041" />
                <TextBlock Text="Theme" Foreground="#253041" />
                <TextBox Text="{Binding SettingsTheme, Mode=TwoWay}" Watermark="System, Light, or Dark" />
                <CheckBox Content="Wrap editor text" IsChecked="{Binding SettingsWordWrap, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Save" Command="{Binding SaveSettingsCommand}" />
                    <Button Content="Cancel" Command="{Binding CloseSettingsCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
